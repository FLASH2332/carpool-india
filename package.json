{
  "name": "greencommute-india",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p amplify --noEmit && tsc -p infra --noEmit",
    "sandbox": "ampx sandbox --profile greencommute",
    "preview": "vite preview",
    "prebuild": "node scripts/prepare-outputs.mjs",
    "test": "tsx --test src/domain.test.ts src/rewards.test.ts amplify/shared/*.test.ts amplify/auth/**/*.test.ts infra/lambda/aqi/*.test.ts",
    "aws:access": "tsx scripts/aws-access.ts",
    "infra": "tsx scripts/infra.ts",
    "geo:env": "tsx scripts/geo-env.ts",
    "seed:aqi": "tsx scripts/seed-aqi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-location": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-textract": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@aws/amazon-location-utilities-auth-helper": "^1.3.3",
    "@turf/turf": "^7.4.0",
    "aws-amplify": "^6.22.1",
    "maplibre-gl": "^6.13.0",
    "ngeohash": "^0.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@aws-sdk/client-sts": "^3.1149.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
